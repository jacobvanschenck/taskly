---
import ProfileMenu from "./ProfileMenu.astro";
---

<div
  x-data="{ sidebarIsOpen: false }"
  class="relative flex w-full flex-col md:flex-row"
>
  <!-- This allows screen readers to skip the sidebar and go directly to the main content. -->
  <a class="sr-only" href="#main-content">
    skip to the main content
  </a>

  <!-- dark overlay for when the sidebar is open on smaller screens  -->
  <div
    x-show="sidebarIsOpen"
    x-cloak
    class="bg-surface-dark/10 fixed inset-0 z-20 backdrop-blur-xs md:hidden"
    aria-hidden="true"
    x-on:click="sidebarIsOpen = false"
    x-transition.opacity
  ></div>

  <nav
    x-cloak
    class="bg-surface-alt border-outline dark:border-outline-dark dark:bg-surface-dark-alt fixed left-0 z-30 flex h-svh w-60 shrink-0 flex-col border-r p-4 transition-transform duration-300 md:relative md:w-64 md:translate-x-0"
    x-bind:class="sidebarIsOpen ? 'translate-x-0' : '-translate-x-60'"
    aria-label="sidebar navigation"
  >
    <!-- logo  -->
    <a
      href="#"
      class="text-on-surface-strong dark:text-on-surface-dark-strong ml-2 w-fit text-2xl font-bold"
    >
      <span class="sr-only">homepage</span>
      Taskly
    </a>

    <!-- search  -->
    <div class="text-on-surface dark:text-on-surface-dark relative my-4 flex w-full max-w-xs flex-col gap-1">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke="currentColor"
        fill="none"
        stroke-width="2"
        class="text-on-surface/50 dark:text-on-surface-dark/50 absolute top-1/2 left-2 size-5 -translate-y-1/2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        />
      </svg>
      <input
        type="search"
        class="border-outline rounded-radius bg-surface dark:border-outline-dark dark:bg-surface-dark/50 dark:focus-visible:outline-primary-dark focus-visible:outline-primary w-full border px-2 py-1.5 pl-9 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-75"
        name="search"
        aria-label="Search"
        placeholder="Search"
      />
    </div>

    <!-- sidebar links  -->
    <div class="flex flex-col gap-2 overflow-y-auto pb-6">
      <a
        href="#"
        class="rounded-radius text-on-surface dark:text-on-surface-dark dark:hover:bg-primary-dark/5 dark:hover:text-on-surface-dark-strong hover:bg-primary/5 hover:text-on-surface-strong flex items-center gap-2 px-2 py-1.5 text-sm font-medium underline-offset-2 focus:outline-hidden focus-visible:underline"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-5 shrink-0"
          aria-hidden="true"
        >
          <path d="M15.5 2A1.5 1.5 0 0 0 14 3.5v13a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 16.5 2h-1ZM9.5 6A1.5 1.5 0 0 0 8 7.5v9A1.5 1.5 0 0 0 9.5 18h1a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 10.5 6h-1ZM3.5 10A1.5 1.5 0 0 0 2 11.5v5A1.5 1.5 0 0 0 3.5 18h1A1.5 1.5 0 0 0 6 16.5v-5A1.5 1.5 0 0 0 4.5 10h-1Z" />
        </svg>
        <span>Dashboard</span>
      </a>
    </div>
    <ProfileMenu />
  </nav>

  <!-- top navbar & main content  -->
  <div class="bg-surface dark:bg-surface-dark h-svh w-full overflow-y-auto">
    <!-- top navbar  -->
    <nav
      class="border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt sticky top-0 z-10 flex items-center justify-between border-b px-4 py-2"
      aria-label="top navibation bar"
    >
      <!-- sidebar toggle button for small screens  -->
      <button
        type="button"
        class="text-on-surface dark:text-on-surface-dark inline-block md:hidden"
        x-on:click="sidebarIsOpen = true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="size-5"
          aria-hidden="true"
        >
          <path d="M0 3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm5-1v12h9a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1zM4 2H2a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h2z" />
        </svg>
        <span class="sr-only">sidebar toggle</span>
      </button>
      <!-- breadcrumbs  -->
      <nav
        class="text-on-surface dark:text-on-surface-dark hidden text-sm font-medium md:inline-block"
        aria-label="breadcrumb"
      >
        <ol class="flex flex-wrap items-center gap-1">
          <li class="flex items-center gap-1">
            <a
              href="#"
              class="dark:hover:text-on-surface-dark-strong hover:text-on-surface-strong"
            >
              Dashboard
            </a>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              stroke="currentColor"
              fill="none"
              stroke-width="2"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"
              />
            </svg>
          </li>

          <li
            class="text-on-surface-strong dark:text-on-surface-dark-strong flex items-center gap-1 font-bold"
            aria-current="page"
          >
            Marketing
          </li>
        </ol>
      </nav>
    </nav>
    <!-- main content  -->
    <main class="p-4">
      <div class="overflow-y-auto">
        <slot name="main-content" />
      </div>
    </main>
  </div>
</div>
