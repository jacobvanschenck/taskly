---
import { tasksTable } from "../db/schema";
import Checkbox from "./Checkbox.astro";
import NotStartedIcon from "../assets/not-started.svg";
import InProgressIcon from "../assets/in-progress.svg";
import CompletedIcon from "../assets/completed.svg";
import UrgentPriorityIcon from "../assets/urgent-priority.svg";
import HighPriorityIcon from "../assets/high-priority.svg";
import MediumPriorityIcon from "../assets/medium-priority.svg";
import LowPriorityIcon from "../assets/low-priority.svg";

interface Props {
  task: typeof tasksTable.$inferSelect;
}

const { task } = Astro.props;
---

<tr
  hx-get={`/api/tasks/${task.id}`}
  hx-push-url="true"
  class="cursor-pointer hover:bg-primary/5 dark:hover:bg-primary-dark/5"
>
  <td class="p-2 rounded-l-radius">
    <Checkbox />
  </td>
  <td class="p-2">
    {task.priority === "urgent" && <UrgentPriorityIcon />}
    {task.priority === "high" && <HighPriorityIcon />}
    {task.priority === "medium" && <MediumPriorityIcon />}
    {task.priority === "low" && <LowPriorityIcon />}
  </td>
  <td class="p-2">
    {task.status === "not_started" && <NotStartedIcon />}
    {task.status === "in_progress" && <InProgressIcon />}
    {task.status === "completed" && <CompletedIcon />}
  </td>
  <td class="w-full p-2">
    <p>{task.name}</p>
  </td>
  <td class="p-2">
    <p>{task.dueAt}</p>
  </td>
  <td class="p-2 rounded-r-radius">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6"
    >
      <path d="M17.925 20.056a6 6 0 0 0-11.851.001" />
      <circle cx="12" cy="11" r="4" />
      <circle cx="12" cy="12" r="10" />
    </svg>
  </td>
</tr>
