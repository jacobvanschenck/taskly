{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "taskly",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "MY_KV",
			"id": "6f2dd663e1f74e779cf96419cd49e38a",
			"remote": true
		}
	]
}